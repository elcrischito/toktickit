# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file. Values below are placeholders only.
# On Cloud Run the same variables are set by deploy/deploy.sh; secrets come from Secret Manager.

# PostgreSQL connection string. SECRET in the cloud (Secret Manager: toktickit-database-url).
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"

# Port the API listens on. Local default 5000 (the Vite dev proxy uses it). Cloud Run sets 3000.
PORT=5000

# Secret used to sign login tokens. Any long random string locally.
# SECRET in the cloud (Secret Manager: toktickit-jwt-secret). Required when NODE_ENV=production.
JWT_SECRET="change-me-to-a-long-random-string"

# Runtime mode. Cloud Run uses "production".
# NODE_ENV=development

# First administrator password used by the seed (admin@toktickit.com, must change it at first login).
# Required when NODE_ENV=production. SECRET in the cloud (toktickit-admin-password).
# Locally it falls back to the documented dev password.
# ADMIN_PASSWORD=change-me

# Demo users and sample tickets for the Lab 6 UAT. Default: on locally, off in production.
# SEED_DEMO_DATA=false
# Password of every demo user. Required when SEED_DEMO_DATA=true in production.
# SECRET in the cloud (toktickit-demo-password).
# DEMO_USER_PASSWORD=change-me

# Allowed web origins, comma-separated (optional). Not needed when the UI and API share one origin.
# CORS_ORIGIN=http://localhost:5173

# Folder of the built React app served by the API in the single container (optional).
# Default: ../client/dist next to the server folder.
# CLIENT_DIST_DIR=/app/client/dist
