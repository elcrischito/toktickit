// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Issue 3 — Create and seed IT request categories
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// Issue 5 — Development Requester context (Lab 2)
model DevRequester {
  id                 Int          @id @default(autoincrement())
  name               String
  email              String       @unique
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  tickets            Ticket[]
  removedAttachments Attachment[]
}

// ---------------------------------------------------------------------------
// Issue 7 — Related Systems reference data (Lab 2)
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// Issue 8 — Ticket creation (Lab 2)
enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  requesterId       Int
  requester         DevRequester      @relation(fields: [requesterId], references: [id])
  categoryId        Int
  category          Category          @relation(fields: [categoryId], references: [id])
  relatedSystemId   Int
  relatedSystem     RelatedSystem     @relation(fields: [relatedSystemId], references: [id])
  summary           String
  description       String
  requestedPriority RequestedPriority
  itPriority        RequestedPriority?
  currentStatus     TicketStatus      @default(NEW)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  attachments       Attachment[]

  @@index([requesterId])
  @@index([currentStatus])
  @@index([categoryId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Issue 6 — Attachment lifecycle (upload, download, soft-remove)
model Attachment {
  id            Int           @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket        @relation(fields: [ticketId], references: [id])
  filename      String
  originalName  String
  mimeType      String
  size          Int
  isRemoved     Boolean       @default(false)
  removedAt     DateTime?
  removalReason String?
  removedById   Int?
  removedBy     DevRequester? @relation(fields: [removedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([ticketId])
}